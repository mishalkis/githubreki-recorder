{
 "winget_id": "Audacity.Audacity",
 "launch": "Audacity",
 "title": "Audacity",
 "settle": 6,
 "pre": [
  "New-Item -ItemType Directory -Force \"$env:APPDATA\\audacity\" | Out-Null",
  "Set-Content -Encoding ascii \"$env:APPDATA\\audacity\\audacity.cfg\" \"[Locale]`nLanguage=ru`n[GUI]`nShowSplashScreen=0`n[Update]`nDefaultUpdatesChecking=0`nUpdateNoticeShown=1\"",
  "Log (\"langs: \" + ((Get-ChildItem \"C:\\Program Files\\Audacity\\Languages\" -Directory -ErrorAction SilentlyContinue | Measure-Object).Count) + \" ru: \" + (Test-Path \"C:\\Program Files\\Audacity\\Languages\\ru\\audacity.mo\"))"
 ],
 "inputs": [
  "voice_noisy.wav"
 ],
 "steps": [
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "mark",
   "name": "opened"
  },
  {
   "do": "winlist"
  },
  {
   "do": "uia_dump",
   "name": "uia_main"
  }
 ],
 "winget_version": "3.7.7",
 "post": [
  "Get-Content \"$env:APPDATA\\audacity\\audacity.cfg\" | Select-String -Pattern \"Lang|Splash|Update\""
 ],
 "args": "C:\\demo\\voice_noisy.wav"
}