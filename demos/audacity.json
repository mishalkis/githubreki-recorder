{
 "winget_id": "Audacity.Audacity",
 "launch": "Audacity",
 "title": "Audacity",
 "settle": 6,
 "pre": [
  "New-Item -ItemType Directory -Force \"$env:APPDATA\\audacity\" | Out-Null",
  "Set-Content -Encoding ascii \"$env:APPDATA\\audacity\\audacity.cfg\" \"[Locale]`nLanguage=ru\""
 ],
 "inputs": [
  "voice_noisy.wav"
 ],
 "steps": [
  {
   "do": "restore",
   "title": "App updates"
  },
  {
   "do": "wait",
   "s": 1.2
  },
  {
   "do": "keys",
   "keys": "{ENTER}"
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "click",
   "x": 1070,
   "y": 873
  },
  {
   "do": "wait",
   "s": 1.5
  },
  {
   "do": "click",
   "x": 1316,
   "y": 820
  },
  {
   "do": "wait",
   "s": 1.5
  },
  {
   "do": "winlist"
  },
  {
   "do": "click",
   "x": 960,
   "y": 600
  },
  {
   "do": "hotkey",
   "keys": "ctrl+p"
  },
  {
   "do": "wait",
   "s": 2.5
  },
  {
   "do": "mark",
   "name": "prefs"
  },
  {
   "do": "winlist"
  }
 ],
 "winget_version": "3.7.7",
 "post": [
  "Get-Content \"$env:APPDATA\\audacity\\audacity.cfg\" | Select-String -Pattern 'Lang|Locale'"
 ],
 "args": "C:\\demo\\voice_noisy.wav"
}