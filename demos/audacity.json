{
 "winget_id": "Audacity.Audacity",
 "launch": "Audacity",
 "title": "Audacity",
 "settle": 6,
 "pre": [
  "New-Item -ItemType Directory -Force \"$env:APPDATA\\audacity\" | Out-Null",
  "Set-Content -Encoding ascii -NoNewline \"$env:APPDATA\\audacity\\audacity.cfg\" \"PrefsVersion=1.1.1r1`n[Locale]`nLanguage=ru`n[GUI]`nShowSplashScreen=0`n[Update]`nDefaultUpdatesChecking=0`nUpdateNoticeShown=1`n[Version]`nMajor=3`nMinor=7`nMicro=7`n\"",
  "Log (\"langs: \" + ((Get-ChildItem \"C:\\Program Files\\Audacity\\Languages\" -Directory -ErrorAction SilentlyContinue | Measure-Object).Count) + \" ru: \" + (Test-Path \"C:\\Program Files\\Audacity\\Languages\\ru\\audacity.mo\"))",
  "Log (\"cfg before: \" + ((Get-Content \"$env:APPDATA\\audacity\\audacity.cfg\") -join \" | \"))"
 ],
 "inputs": [
  "voice_noisy.wav"
 ],
 "steps": [
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "mark",
   "name": "opened"
  },
  {
   "do": "winlist"
  },
  {
   "do": "uia_dump",
   "name": "uia_main"
  }
 ],
 "winget_version": "3.7.7",
 "post": [
  "Log (\"cfg after: \" + ((Get-Content \"$env:APPDATA\\audacity\\audacity.cfg\" | ForEach-Object { if ($_.Length -gt 80) { $_.Substring(0,80) } else { $_ } }) -join \" | \"))"
 ],
 "args": "C:\\demo\\voice_noisy.wav"
}