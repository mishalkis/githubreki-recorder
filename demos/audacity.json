{
 "winget_id": "Audacity.Audacity",
 "launch": "Audacity",
 "title": "Audacity",
 "settle": 6,
 "pre": [
  "New-Item -ItemType Directory -Force \"$env:APPDATA\\audacity\" | Out-Null",
  "Set-Content -Encoding ascii \"$env:APPDATA\\audacity\\audacity.cfg\" \"[Update]`nUpdateNoticeShown=1\""
 ],
 "inputs": [
  "voice_noisy.wav"
 ],
 "steps": [
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "x"
  }
 ],
 "post": [],
 "args": "C:\\demo\\voice_noisy.wav",
 "setup": [
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "hotkey",
   "keys": "ctrl+p"
  },
  {
   "do": "wait",
   "s": 3
  },
  {
   "do": "uia_dump",
   "name": "uia_prefs"
  },
  {
   "do": "winlist"
  }
 ]
}