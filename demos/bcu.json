{
 "winget_id": "Klocman.BulkCrapUninstaller",
 "launch": "BCUninstaller",
 "title": "Bulk|Crap|BCU",
 "settle": 10,
 "pre": [
  "Set-WinUserLanguageList -LanguageList ru-RU -Force",
  "Get-ChildItem -Recurse -Filter *.lnk \"$env:ProgramData\\Microsoft\\Windows\\Start Menu\",\"$env:APPDATA\\Microsoft\\Windows\\Start Menu\" | ? Name -match 'BCU|Crap|Uninst' | % FullName",
  "Get-ChildItem -Recurse -Filter *.exe \"$env:ProgramFiles\",\"${env:ProgramFiles(x86)}\",\"$env:LOCALAPPDATA\\Programs\" -ErrorAction SilentlyContinue | ? FullName -match 'BCU|Crap' | select -First 5 | % FullName"
 ],
 "inputs": [],
 "steps": [
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "mark",
   "name": "a"
  },
  {
   "do": "winlist"
  }
 ]
}