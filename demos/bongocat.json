{
 "winget_id": "ayangweb.BongoCat",
 "launch": "notepad.exe",
 "args": "C:\\demo\\note.txt",
 "title": "note",
 "settle": 3,
 "pre": [
  "New-Item -ItemType Directory -Force C:\\demo | Out-Null; Set-Content -Encoding utf8 C:\\demo\\note.txt (\"Список дел на неделю`r`n\" + (\"`r`n\"*24) + \"1. Купить продукты`r`n2. Отправить отчёт`r`n3. Позвонить маме`r`n\")",
  "Get-ChildItem -Recurse -Filter *.lnk \"$env:ProgramData\\Microsoft\\Windows\\Start Menu\",\"$env:APPDATA\\Microsoft\\Windows\\Start Menu\" | ? Name -match 'ongo' | % FullName"
 ],
 "inputs": [],
 "setup": [
  {
   "do": "launch",
   "target": "BongoCat"
  },
  {
   "do": "wait",
   "s": 8
  }
 ],
 "steps": [
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "click",
   "x": 1200,
   "y": 800
  },
  {
   "do": "hotkey",
   "keys": "ctrl+end"
  },
  {
   "do": "type",
   "text": "4. Записаться к врачу"
  },
  {
   "do": "hotkey",
   "keys": "enter"
  },
  {
   "do": "type",
   "text": "5. Погулять с собакой"
  },
  {
   "do": "mark",
   "name": "a"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "type",
   "text": " и купить хлеб"
  },
  {
   "do": "mark",
   "name": "b"
  }
 ],
 "refind": false
}