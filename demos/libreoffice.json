{
 "winget_id": "TheDocumentFoundation.LibreOffice",
 "launch": "LibreOffice Writer",
 "title": "Writer|LibreOffice|Без имени",
 "settle": 8,
 "pre": [
  "Remove-Item \"$env:APPDATA\\LibreOffice\" -Recurse -Force -ErrorAction SilentlyContinue",
  "Start-Process \"C:\\Program Files\\LibreOffice\\program\\soffice.exe\" -ArgumentList \"--writer\"; Start-Sleep 25; Get-Process soffice,soffice.bin -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep 3",
  "Log (\"xcu \" + \"after first start\" + \": \" + ((Select-String -Path \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Pattern \"L10N|FirstRun|Wizard|Welcome\" | ForEach-Object { $_.Line.Substring(0,[Math]::Min(150,$_.Line.Length)) }) -join \" ## \"))",
  "$f=\"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\"; $x=Get-Content $f -Raw -Encoding UTF8; $x=[regex]::Replace($x,'(oor:name=\"ooLocale\"[^>]*><value>)[^<]*','${1}ru'); $x=[regex]::Replace($x,'(oor:name=\"FirstRun\"[^>]*><value>)[^<]*','${1}false'); if ($x -notmatch 'ooLocale') { $x=$x -replace '</oor:items>','<item oor:path=\"/org.openoffice.Setup/L10N\"><prop oor:name=\"ooLocale\" oor:op=\"fuse\"><value>ru</value></prop></item></oor:items>' }; [IO.File]::WriteAllText($f,$x,(New-Object Text.UTF8Encoding $false))",
  "Log (\"xcu \" + \"patched\" + \": \" + ((Select-String -Path \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Pattern \"L10N|FirstRun|Wizard|Welcome\" | ForEach-Object { $_.Line.Substring(0,[Math]::Min(150,$_.Line.Length)) }) -join \" ## \"))"
 ],
 "inputs": [
  "report.docx"
 ],
 "steps": [
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "writer_blank"
  },
  {
   "do": "hotkey",
   "keys": "ctrl+o"
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "keys",
   "keys": "C:\\demo\\report.docx{ENTER}"
  },
  {
   "do": "wait",
   "s": 3.5
  },
  {
   "do": "mark",
   "name": "writer_report"
  },
  {
   "do": "hotkey",
   "keys": "shift+f7"
  },
  {
   "do": "wait",
   "s": 0.5
  },
  {
   "do": "hotkey",
   "keys": "ctrl+home"
  },
  {
   "do": "keys",
   "keys": "+{END}"
  },
  {
   "do": "wait",
   "s": 0.5
  },
  {
   "do": "hotkey",
   "keys": "ctrl+1"
  },
  {
   "do": "wait",
   "s": 0.8
  },
  {
   "do": "hotkey",
   "keys": "ctrl+e"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "heading"
  },
  {
   "do": "hotkey",
   "keys": "ctrl+end"
  },
  {
   "do": "type",
   "text": " Прогноз: рост продаж сохранится."
  },
  {
   "do": "wait",
   "s": 0.8
  },
  {
   "do": "keys",
   "keys": "+{HOME}"
  },
  {
   "do": "wait",
   "s": 0.3
  },
  {
   "do": "hotkey",
   "keys": "ctrl+b"
  },
  {
   "do": "wait",
   "s": 0.8
  },
  {
   "do": "mark",
   "name": "edited"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "launch",
   "target": "LibreOffice Calc"
  },
  {
   "do": "wait",
   "s": 7
  },
  {
   "do": "hotkey",
   "keys": "win+up"
  },
  {
   "do": "wait",
   "s": 1.5
  },
  {
   "do": "mark",
   "name": "calc_open"
  },
  {
   "do": "winlist"
  },
  {
   "do": "keys",
   "keys": "Месяц{TAB}Выручка{TAB}Затраты{TAB}Прибыль{ENTER}Январь{TAB}120{TAB}80{TAB}=B2-C2{ENTER}Февраль{TAB}150{TAB}85{TAB}=B3-C3{ENTER}Март{TAB}180{TAB}90{TAB}=B4-C4{ENTER}Апрель{TAB}210{TAB}95{TAB}=B5-C5{ENTER}Май{TAB}240{TAB}100{TAB}=B6-C6{ENTER}"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "calc_data"
  }
 ],
 "winget_args": "UI_LANGS=en_US,ru",
 "post": [
  "Log (\"xcu \" + \"end\" + \": \" + ((Select-String -Path \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Pattern \"L10N|FirstRun|Wizard|Welcome\" | ForEach-Object { $_.Line.Substring(0,[Math]::Min(150,$_.Line.Length)) }) -join \" ## \"))"
 ],
 "setup": [
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "hotkey",
   "keys": "alt+f12"
  },
  {
   "do": "wait",
   "s": 3
  },
  {
   "do": "click_text",
   "text": "Languages and Locales"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "keys",
   "keys": "{RIGHT}{DOWN}"
  },
  {
   "do": "wait",
   "s": 1.5
  },
  {
   "do": "click",
   "x": 1096,
   "y": 241
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "keys",
   "keys": "Russian"
  },
  {
   "do": "wait",
   "s": 0.5
  },
  {
   "do": "keys",
   "keys": "{ENTER}"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "uia_dump",
   "name": "uia_lang2"
  },
  {
   "do": "click_text",
   "text": "OK"
  },
  {
   "do": "wait",
   "s": 2.5
  },
  {
   "do": "uia_dump",
   "name": "uia_restart"
  },
  {
   "do": "click_text",
   "text": "Restart Now"
  },
  {
   "do": "wait",
   "s": 15
  },
  {
   "do": "winlist"
  }
 ]
}