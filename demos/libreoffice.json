{
 "winget_id": "TheDocumentFoundation.LibreOffice",
 "launch": "LibreOffice Writer",
 "title": "Writer|LibreOffice|Без имени",
 "settle": 8,
 "pre": [
  "New-Item -ItemType Directory -Force \"$env:APPDATA\\LibreOffice\\4\\user\" | Out-Null",
  "Copy-Item C:\\demo\\lo_registry.xcu \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Force"
 ],
 "inputs": [
  "lo_registry.xcu",
  "report.docx"
 ],
 "steps": [
  {
   "do": "wait",
   "s": 6
  },
  {
   "do": "click",
   "x": 1235,
   "y": 683
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "uia_dump",
   "name": "uia_w2"
  }
 ],
 "winget_args": "UI_LANGS=en_US,ru",
 "post": [
  "Select-String -Path \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Pattern 'ooLocale|FirstRun|TipOfTheDay' | Select-Object -First 8 | ForEach-Object { $_.Line.Substring(0,[Math]::Min(180,$_.Line.Length)) }",
  "Get-ChildItem 'C:\\Program Files\\LibreOffice\\program' -Filter 'resource*' | Select-Object -ExpandProperty Name",
  "(Get-ChildItem 'C:\\Program Files\\LibreOffice\\program\\resource' -ErrorAction SilentlyContinue | Select-Object -First 30 -ExpandProperty Name) -join ' '",
  "(Get-ChildItem 'C:\\Program Files\\LibreOffice\\share\\config' -ErrorAction SilentlyContinue | Select-Object -First 20 -ExpandProperty Name) -join ' '"
 ]
}