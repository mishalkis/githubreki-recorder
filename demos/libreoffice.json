{
 "winget_id": "TheDocumentFoundation.LibreOffice",
 "launch": "LibreOffice Writer",
 "title": "Writer|LibreOffice|Без имени",
 "settle": 8,
 "pre": [
  "New-Item -ItemType Directory -Force \"$env:APPDATA\\LibreOffice\\4\\user\" | Out-Null",
  "Set-WinUserLanguageList -LanguageList ru-RU -Force",
  "Start-Process 'C:\\Program Files\\LibreOffice\\program\\soffice.exe' -ArgumentList '--headless','--terminate_after_init' -Wait; Start-Sleep 3",
  "$f=\"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\"; $x=Get-Content $f -Raw -Encoding UTF8; $x=[regex]::Replace($x,'(oor:name=\"ooLocale\"[^>]*><value>)[^<]*','${1}ru'); $x=[regex]::Replace($x,'(oor:name=\"FirstRun\"[^>]*><value>)[^<]*','${1}false'); Set-Content $f $x -Encoding UTF8",
  "Select-String -Path \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Pattern 'ooLocale|FirstRun' | ForEach-Object { $_.Line.Substring(0,[Math]::Min(160,$_.Line.Length)) }"
 ],
 "inputs": [
  "report.docx"
 ],
 "steps": [
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "writer_ready"
  },
  {
   "do": "click",
   "x": 900,
   "y": 300
  },
  {
   "do": "type",
   "text": "Квартальный отчёт"
  },
  {
   "do": "hotkey",
   "keys": "ctrl+1"
  },
  {
   "do": "wait",
   "s": 0.5
  },
  {
   "do": "hotkey",
   "keys": "enter"
  },
  {
   "do": "type",
   "text": "Продажи выросли на 20 процентов."
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "heading_applied"
  },
  {
   "do": "launch",
   "target": "LibreOffice Calc"
  },
  {
   "do": "wait",
   "s": 7
  },
  {
   "do": "winlist"
  },
  {
   "do": "keys",
   "keys": "10{TAB}20{TAB}30{TAB}"
  },
  {
   "do": "type",
   "text": "=СУММ"
  },
  {
   "do": "keys",
   "keys": "(A1:C1){ENTER}"
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "mark",
   "name": "calc_sum"
  }
 ],
 "winget_args": "UI_LANGS=en_US,ru",
 "post": [
  "Get-ChildItem \"$env:APPDATA\\LibreOffice\\4\\user\" | Select-Object -ExpandProperty Name",
  "Select-String -Path \"$env:APPDATA\\LibreOffice\\4\\user\\registrymodifications.xcu\" -Pattern 'ooLocale|FirstRun' | ForEach-Object { $_.Line.Substring(0,[Math]::Min(160,$_.Line.Length)) }"
 ],
 "setup": [
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "click",
   "x": 1276,
   "y": 327
  },
  {
   "do": "wait",
   "s": 1
  }
 ]
}