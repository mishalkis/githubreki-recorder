{
  "winget_id": "LocalSend.LocalSend",
  "launch": "LocalSend",
  "title": "LocalSend",
  "settle": 4,
  "pre": [
    "New-Item -ItemType Directory -Force \"$env:APPDATA\\LocalSend\" | Out-Null",
    "Set-Content -Encoding ascii \"$env:APPDATA\\LocalSend\\settings.json\" '{\"flutter.ls_locale\":\"ru\"}'"
  ],
  "inputs": [
    "test.png"
  ],
  "steps": [
    {
      "do": "wait",
      "s": 2
    },
    {
      "do": "mark",
      "name": "home"
    },
    {
      "do": "click",
      "x": 95,
      "y": 191
    },
    {
      "do": "wait",
      "s": 1.5
    },
    {
      "do": "mark",
      "name": "send_tab"
    },
    {
      "do": "click",
      "x": 864,
      "y": 138
    },
    {
      "do": "wait",
      "s": 3
    },
    {
      "do": "type",
      "text": "C:\\demo\\test.png"
    },
    {
      "do": "hotkey",
      "keys": "enter"
    },
    {
      "do": "wait",
      "s": 2.5
    },
    {
      "do": "mark",
      "name": "file_selected"
    }
  ],
  "dump": [
    "%APPDATA%\\LocalSend\\*.json"
  ]
}